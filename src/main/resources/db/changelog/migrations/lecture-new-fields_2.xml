<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="lecture-new-fields" author="aryan">
        <addColumn tableName="lecture_management">
            <column name="lecture_name" type="text" defaultValue="Untitled Lecture"/>
            <column name="lecture_description" type="text" defaultValue="No description"/>
        </addColumn>
    </changeSet>
    <changeSet id="update-default-values" author="aryan">
        <update tableName="lecture_management">
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="notes" value=""/>
            <column name="test_ids" value="{}"/>
            <column name="topics" value="{}"/>
        </update>
    </changeSet>
  

</databaseChangeLog>
