type User {
  id: String!
  username: String!
  email: String!
  firstName: String!
  lastName: String!
  role: String!
}
type Classroom {
  id: String!
  studentIds: [String]
  description: String
  lectures: [String]
  clientType: String
  instructorIds: [String]
  attendance: [Attendance]
  classroomName: String
  inviteLink: String
  inviteLinkExpiry: String
  organizationId: String
  classroomCode: String
  students: [User]
}
type Attendance {
  date: String
  students: [String]
}
