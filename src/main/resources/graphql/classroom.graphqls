type Classroom {
  id: String!
  studentIds: [String]
  description: String
  lectures: [String]
  clientType: String
  instructorIds: [String]
  attendance: [Attendance]
  classroomName: String
  inviteLink: String
  inviteLinkExpiry: String
  organizationId: String
  classroomCode: String
}
type Attendance {
  date: String
  students: [String]
}
